<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#111A2E"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Update your student information"
            android:textColor="#667085"
            android:textSize="14sp" />


        <!-- NAME -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Full Name"
            android:textColor="#344054"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditStudentName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="#FFFFFF"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:padding="15dp"
            android:singleLine="true" />


        <!-- ROLL NO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Roll Number"
            android:textColor="#344054"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditStudentRollNo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="#FFFFFF"
            android:hint="Enter roll number"
            android:inputType="text"
            android:padding="15dp"
            android:singleLine="true" />


        <!-- CLASS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Class"
            android:textColor="#344054"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEditStudentClass"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="#FFFFFF" />


        <!-- SAVE -->

        <Button
            android:id="@+id/btnSaveStudentProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="SAVE CHANGES"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>