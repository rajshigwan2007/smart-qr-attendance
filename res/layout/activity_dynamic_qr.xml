<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:gravity="center_horizontal">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LIVE SESSION" android:textColor="#2457D6" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                <TextView android:id="@+id/btnSessionMenu" android:layout_width="48dp" android:layout_height="48dp" android:background="#E7EEFF" android:gravity="center" android:text="⋮" android:textColor="#2457D6" android:textSize="28sp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Live Attendance QR" android:textColor="#111A2E" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvQRClass" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Class" android:textColor="#111A2E" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvQRSubject" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subject" android:textColor="#667085" android:textSize="14sp"/>
            <TextView android:id="@+id/tvQRStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Preparing live session…" android:textColor="#2457D6" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvQRTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="15:00" android:textColor="#111A2E" android:textSize="32sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvQRTokenTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QR will appear here" android:textColor="#667085" android:textSize="13sp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="18dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="26dp" app:cardElevation="2dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp">
                    <ImageView android:id="@+id/ivQRCode" android:layout_width="310dp" android:layout_height="310dp" android:layout_gravity="center" android:scaleType="fitCenter" android:background="#FFFFFF" android:contentDescription="Live attendance QR code"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="The QR changes automatically every 10 seconds. Students must scan the current code." android:textColor="#667085" android:textSize="13sp" android:gravity="center" android:lineSpacingExtra="2dp"/>
            <Button android:id="@+id/btnCloseSession" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:layout_marginBottom="22dp" android:text="CLOSE SESSION" android:textStyle="bold" android:backgroundTint="#D64545" android:textColor="#FFFFFF" android:enabled="false"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
